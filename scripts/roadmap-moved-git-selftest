#!/usr/bin/env bash
# PROVES THE GIT PATH OF roadmap-moved, which the fixture selftest cannot reach.
#
# The fixture cases go through --baseline-file and so never run a single git
# command: they pin the COMPARISON (does a changed file pass, does an unchanged
# one fail, does trailing whitespace count) and nothing about which two commits
# are being compared.  That second half is the whole of the merge-base reading,
# and it is the half that decides whether a fix-up inside a branch costs the
# roadmap a line -- so it gets a real repository rather than a pair of files.
#
# Everything happens in a scratch repo under $TMPDIR.  It never touches this
# working tree, which is not a stylistic preference: the obvious way to write
# this test is `git stash` around a throwaway branch, and a stash sweeps up the
# very edits being tested.
set -u

CHECK="$(cd "$(dirname "$0")" && pwd)/check-roadmap-moved.py"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
fail=0

note() { printf '  %s\n' "$*"; }
expect() {   # expect <want-exit> <label>
  local want="$1" label="$2" got
  ( cd "$TMP" && "$CHECK" >/dev/null 2>&1 ); got=$?
  if [ "$got" -ne "$want" ]; then
    echo "SELFTEST FAIL: $label (wanted exit $want, got $got)"
    fail=1
  fi
}

cd "$TMP" || exit 1
git init -q -b main .
git config user.email t@t; git config user.name t
mkdir -p agda/src
printf 'row A\n'       > PROOF-STATE.md
printf 'module M where\nx = 1\n' > agda/src/M.agda
git add -A && git commit -qm base

# A BRANCH THAT CHANGES AGDA AND SAYS NOTHING ABOUT THE PLAN -- the finding the
# check exists for, and it must survive the move to a merge-base baseline.
git checkout -qb leg
printf 'y = 2\n' >> agda/src/M.agda
git commit -qam 'proof work, no roadmap'
expect 1 "agda changed and the roadmap did not -- the check did not fire"

# THE LEG REPORTS ITSELF: the roadmap moves, and the branch goes green.
printf 'row A, narrowed\n' > PROOF-STATE.md
git commit -qam 'roadmap: narrow row A'
expect 0 "a branch whose roadmap moved was rejected"

# THE POINT OF THE MERGE-BASE BASELINE.  A fix-up commit -- the repaired
# reassembly, the missing import, the error the first build found -- touches
# agda/ and leaves the roadmap alone.  Against HEAD~1 that is a FAIL and the
# branch is taxed per keystroke; against the merge-base the leg has already
# said its piece and this costs nothing.
printf 'z = 3\n' >> agda/src/M.agda
git commit -qam 'fix-up: repair the reassembly'
expect 0 "a fix-up inside a branch that already moved the roadmap was rejected"

# AND THE EXEMPTION STILL APPLIES ON A BRANCH THAT TOUCHED NO AGDA AT ALL.
git checkout -q main && git checkout -qb tooling
printf 'docs\n' > README-tooling.md
git add -A && git commit -qm 'tooling only'
expect 0 "a branch touching nothing under agda/ was not exempt"

# ON main ITSELF the merge-base is HEAD, so the per-commit fallback must still
# hold a direct landing rather than passing it silently.
git checkout -q main
printf 'w = 4\n' >> agda/src/M.agda
git commit -qam 'direct landing on main, no roadmap'
expect 1 "a direct commit to main with no roadmap move was not held"

[ "$fail" -eq 0 ] && echo "roadmap-moved-git-selftest: OK"
exit "$fail"
